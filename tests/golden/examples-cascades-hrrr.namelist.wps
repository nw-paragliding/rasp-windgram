&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2026-04-06_00:00:00', '2026-04-06_00:00:00',
 end_date   = '2026-04-08_00:00:00', '2026-04-08_00:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1, 1,
 parent_grid_ratio = 1, 3,
 i_parent_start    = 1, 11,
 j_parent_start    = 1, 11,
 e_we              = 55, 103,
 e_sn              = 55, 103,
 geog_data_res     = 'default+lowres', 'default+lowres',
 dx = 3000.0,
 dy = 3000.0,
 map_proj = 'lambert',
 ref_lat  = 47.6000,
 ref_lon  = -121.4000,
 truelat1 = 47.6000,
 truelat2 = 47.6000,
 stand_lon = -121.4000,
 geog_data_path = '/mnt/geog',
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
/
