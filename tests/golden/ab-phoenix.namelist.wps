&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2026-04-06_00:00:00', '2026-04-06_00:00:00',
 end_date   = '2026-04-09_12:00:00', '2026-04-09_12:00:00',
 interval_seconds = 10800,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         = 1, 1,
 parent_grid_ratio = 1, 3,
 i_parent_start    = 1, 11,
 j_parent_start    = 1, 11,
 e_we              = 59, 115,
 e_sn              = 59, 115,
 geog_data_res     = 'gmted2010_30s+modis_30s_lake+lowres', 'gmted2010_30s+modis_30s_lake+lowres',
 dx = 4000.0,
 dy = 4000.0,
 map_proj = 'lambert',
 ref_lat  = 33.5000,
 ref_lon  = -112.0000,
 truelat1 = 33.5000,
 truelat2 = 33.5000,
 stand_lon = -112.0000,
 geog_data_path = '/mnt/geog',
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
/
